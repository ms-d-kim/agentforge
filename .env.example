# Copy to .env and fill in. Never commit .env (spec §14, gitignored).
# Pick ONE provider per experiment run (spec §14: no mixing providers in one run).

# --- OpenRouter (default for this project) — OpenAI-compatible gateway ---
AGENTFORGE_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# Model id is vendor-prefixed. Mid-tier leaves headroom for workflow strategy to matter.
# AGENTFORGE_OPENROUTER_MODEL=openai/gpt-4o-mini
# Other good picks: google/gemini-2.5-flash, anthropic/claude-3.5-haiku, anthropic/claude-sonnet-4.6

# --- Anthropic (direct) ---
# AGENTFORGE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://...        # optional gateway/proxy; SDK reads it automatically

# --- OpenAI (direct) ---
# AGENTFORGE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AGENTFORGE_OPENAI_MODEL=gpt-4o
