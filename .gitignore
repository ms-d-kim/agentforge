# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/

# Selector persistence written by the example
examples/*state*.json
selector_state.json

# Secrets — keys via env only (spec §14, CLAUDE.md conventions)
.env

# Data: large BIRD download + generated fixtures (gitignored)
data/bird/
data/fixture/
*.sqlite
*.sqlite3

# LLM response cache (spec §17 cost mitigation)
llm_cache.sqlite

# Outputs — keep the dirs, ignore the contents (committed figures live in results/)
logs/*.jsonl
plots/*.png
plots/*.txt
!logs/.gitkeep
!plots/.gitkeep

# Demo video working files + output (uploaded separately, not via git)
video/

# Demo-video dark figure variants (regenerated by scripts.make_dark_figures)
results/dark/

# Variable-font instancing source (static weights are committed; this isn't needed at runtime)
assets/fonts/SpaceGrotesk-VF.ttf

# macOS
.DS_Store
